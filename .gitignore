# Submission allowlist: internal work stays local.
/*
!/src/
!/pom.xml
!/.gitignore

# Only the root project README is public documentation.
*.[mM][dD]
AGENTS.md
!/README.md

# Generated files, including any placed below src.
*.class
*.log
*.tmp
*.bak

# IDE/editor
.idea/
.vscode/
*.iml
.project
.classpath
.settings/

# OS
.DS_Store
Thumbs.db

# docs/, prompts/, samples/, scripts/, target/, .maven/ and other root items
# remain local under the allowlist. Required test fixtures live in src/test/resources/.
